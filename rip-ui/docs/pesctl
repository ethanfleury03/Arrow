  break
 except TypeError:
  try:
   fn([])
   called = name + '([])'
   break
  except TypeError:
   continue

if not called:
 raise RuntimeError('no compatible depriming method signature on KPesClient (tried startDepriming/deprime/beginDepriming with () and ([]))')

print(json.dumps({
 'ok': True,
 'operation': op,
 'host': host,
 'commandPort': cmd_port,
 'exitCode': 0,
 'output': 'depriming sent via {}'.format(called)
}))
PY
)" || RC=$?
RC=${RC:-0}
if [[ "$RC" -ne 0 ]]; then
 python2 - <<PY
import json
print(json.dumps({
 "ok": False,
 "operation": "$OP",
 "host": "$HOST",
 "commandPort": int("$CMD_PORT"),
