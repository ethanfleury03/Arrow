   fn([])
   called = name + '([])'
   break
  except TypeError:
   continue

if not called:
 raise RuntimeError('no compatible replaceWipers method signature on KPesClient (tried replaceWipers/wiperReplace/changeWipers with () and ([]))')

print(json.dumps({
 'ok': True,
 'operation': op,
 'host': host,
